          "$type": "dimension",
          "$value": "48px"
        },
        "padding": {
          "$type": "dimension",
          "$value": "12px 16px"
        }
      },
      "card": {
        "$description": "Default box (ruled row, not a rounded card). On-demand soft variant (12px, surfaceSoft) for learning surfaces.",
