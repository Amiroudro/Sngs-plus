      "$description": "The default shape: box, square corners.",
      "$type": "borderRadius",
      "$value": "{radius.news}"
    },
    "roles": {
      "banner": {
        "$description": "Box, full-bleed. Masthead, TopStoryHero, story banner/hero image area. Small (4px) variant for the rendered share card only.",
