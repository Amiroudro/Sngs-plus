---
import '../styles/global.css';
---

<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14243f" />
    <meta name="description" content="Read the latest human-reviewed Sarangsho Plus bilingual news edition." />
    <title>Today's briefing | Sarangsho Plus</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Sarangsho Plus home">
        <span class="brand-mark">S+</span>
        <span class="brand-name">SARANGSHO <b>PLUS</b></span>
      </a>
      <nav aria-label="Main navigation">
        <a class="active" href="/today">Today</a>
        <a href="/#exam-desk">Exam desk</a>
        <a href="/#method">Our method</a>
      </nav>
      <button class="language" id="language-toggle" type="button" aria-label="Switch to Bangla" aria-pressed="false">বাংলা</button>
    </header>

    <main id="main-content" class="today-shell">
      <section class="today-heading">
        <p class="section-kicker" id="eyebrow">THE SARANGSHO DESK · DAILY EDITION</p>
        <div class="heading-row">
          <div>
            <h1 id="page-title">Today's briefing</h1>
            <p id="edition-date" class="edition-date">Checking for the latest approved edition…</p>
          </div>
          <span class="status-pill" id="edition-status"><span class="status-dot"></span>Connecting</span>
        </div>
        <p id="intro-copy" class="today-intro">Clear reporting, useful context and exam-ready knowledge. Only human-published editions appear here.</p>
      </section>

      <p id="fallback-notice" class="fallback-notice" hidden></p>
      <section id="story-list" class="story-list" aria-live="polite" aria-label="Latest news stories"></section>
      <section class="archive-panel" aria-labelledby="archive-title">
        <div class="archive-heading">
          <h2 id="archive-title">Search the metadata archive</h2>
          <p id="archive-note">Find retained headlines and publisher records that do not have accessible article text. These are archive records, not study notes.</p>
        </div>
        <form id="archive-form">
          <label for="archive-query" id="archive-label">Search headline or publisher</label>
          <div class="archive-controls">
            <input id="archive-query" name="q" type="search" maxlength="160" placeholder="e.g. Bangladesh Bank, climate, budget" />
            <button id="archive-submit" type="submit">Search archive</button>
          </div>
        </form>
        <p id="archive-status" class="archive-status" role="status"></p>
        <div id="archive-results" class="archive-results"></div>
      </section>
      <section id="empty-state" class="empty-state" hidden>
        <span class="empty-mark">S+</span>
        <h2 id="empty-title">No approved edition yet</h2>
        <p id="empty-copy">The content pipeline is being connected. This page will show stories only after an edition passes review and is published.</p>
      </section>
      <p id="error-state" class="error-state" hidden>We could not reach the briefing service. Please try again later.</p>
    </main>

    <footer>
      <a class="footer-brand" href="/"><span class="brand-mark">S+</span><span>SARANGSHO <b>PLUS</b></span></a>
      <span class="footer-note">Independent project · Editorial standards first</span>
      <a href="/">Back to home</a>
    </footer>

    <script>
      const API_BASE = import.meta.env.PUBLIC_API_BASE_URL || '';
      const list = document.querySelector('#story-list');
      const empty = document.querySelector('#empty-state');
      const error = document.querySelector('#error-state');
      const status = document.querySelector('#edition-status');
      const dateLabel = document.querySelector('#edition-date');
      const toggle = document.querySelector('#language-toggle');
      const fallbackNotice = document.querySelector('#fallback-notice');
      const labels = {
        en: {
          title: "Today's briefing", eyebrow: 'THE SARANGSHO DESK · DAILY EDITION',
          intro: 'Clear reporting, useful context and exam-ready knowledge. Only human-published editions appear here.',
          emptyTitle: 'No approved edition yet',
          emptyCopy: 'The content pipeline is being connected. This page will show stories only after an edition passes review and is published.',
          connecting: 'Connecting', live: 'Published edition', unavailable: 'Not published',
          story: 'Story', why: 'Why it matters', facts: 'Key facts', source: 'Read original report',
          context: 'Context and concepts', examNotes: 'Exam notes', practice: 'Practice questions',
          shortQuestions: 'Quick questions', written: 'Written practice', vocabulary: 'Vocabulary',
          revision: 'Quick revision', reveal: 'Show answer and explanation', answer: 'Answer',
          explanation: 'Explanation', sources: 'References', translationPending: 'The Bangla edition is being prepared and reviewed. No English summary is substituted.',
          noLearning: 'Additional exam-learning notes will appear here after source review.',
          words: 'Words', phrases: 'Phrases',
          back: 'Back to home', fallback: 'Bangla translation is awaiting editorial review. The English edition is shown for now.',
          archiveTitle: 'Search the metadata archive',
          archiveNote: 'Find retained headlines and publisher records that do not have accessible article text. These are archive records, not study notes.',
          archiveLabel: 'Search headline or publisher',
          archivePlaceholder: 'e.g. Bangladesh Bank, climate, budget',
          archiveButton: 'Search archive',
          archiveLoading: 'Searching the published archive…',
          archiveEmpty: 'No matching metadata-only records were found.',
          archiveError: 'The archive could not be reached. Please try again later.',
          archiveNoNotes: 'Metadata only · No study notes',
          archiveOpen: 'Open publisher page'
        },
        bn: {
          title: 'আজকের সংবাদসংকলন', eyebrow: 'সারাংশ ডেস্ক · দৈনিক সংস্করণ',
          intro: 'বিশ্বস্ত সংবাদ, প্রয়োজনীয় প্রেক্ষাপট এবং পরীক্ষার উপযোগী জ্ঞান। মানবীয় পর্যালোচনার পর প্রকাশিত সংস্করণই এখানে দেখানো হবে।',
          emptyTitle: 'এখনো অনুমোদিত সংস্করণ প্রকাশিত হয়নি',
          emptyCopy: 'সংবাদ প্রক্রিয়াটি যুক্ত করা হচ্ছে। পর্যালোচনা ও প্রকাশের পরই এখানে সংবাদ দেখানো হবে।',
          connecting: 'সংযোগ করা হচ্ছে', live: 'প্রকাশিত সংস্করণ', unavailable: 'প্রকাশিত হয়নি',
          story: 'সংবাদ', why: 'কেন গুরুত্বপূর্ণ', facts: 'মূল তথ্য', source: 'মূল প্রতিবেদন পড়ুন',
          context: 'প্রেক্ষাপট ও প্রয়োজনীয় ধারণা', examNotes: 'পরীক্ষার নোট', practice: 'অনুশীলন',
          shortQuestions: 'সংক্ষিপ্ত প্রশ্ন', written: 'লিখিত প্রস্তুতি', vocabulary: 'শব্দভান্ডার',
          revision: 'দ্রুত রিভিশন', reveal: 'উত্তর ও ব্যাখ্যা দেখুন', answer: 'উত্তর',
          explanation: 'ব্যাখ্যা', sources: 'তথ্যসূত্র', translationPending: 'বাংলা সংস্করণ প্রস্তুত ও পর্যালোচনার কাজ চলছে। আপাতত ইংরেজি সারাংশ দেখানো হবে না।',
          noLearning: 'যাচাইকৃত অতিরিক্ত পরীক্ষার নোট প্রস্তুত হলে এখানে যুক্ত হবে।',
          words: 'শব্দ', phrases: 'Phrase',
          back: 'প্রচ্ছদে ফিরুন', fallback: 'বাংলা অনুবাদের মানবীয় পর্যালোচনা এখনো সম্পন্ন হয়নি। আপাতত ইংরেজি সংস্করণ দেখানো হচ্ছে।',
          archiveTitle: 'সংরক্ষিত সংবাদ-তথ্য খুঁজুন',
          archiveNote: 'যেসব সংবাদের পূর্ণ লেখা পাওয়া যায়নি, সেগুলোর শিরোনাম ও প্রকাশক-তথ্য এখানে খুঁজুন। এগুলো শুধু আর্কাইভ রেকর্ড, পড়ার নোট নয়।',
          archiveLabel: 'শিরোনাম বা পত্রিকার নাম দিয়ে খুঁজুন',
          archivePlaceholder: 'যেমন: বাংলাদেশ ব্যাংক, জলবায়ু, বাজেট',
          archiveButton: 'আর্কাইভ খুঁজুন',
          archiveLoading: 'প্রকাশিত আর্কাইভে খোঁজা হচ্ছে…',
          archiveEmpty: 'মিল পাওয়া যায়নি।',
          archiveError: 'আর্কাইভে সংযোগ করা যায়নি। পরে আবার চেষ্টা করুন।',
          archiveNoNotes: 'শুধু সংবাদ-তথ্য · পড়ার নোট নেই',
          archiveOpen: 'প্রকাশকের ওয়েবসাইট খুলুন'
        }
      };
      let language = 'bn';

      function asArray(value) {
        return Array.isArray(value) ? value : [];
      }

      function element(tag, className, text) {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined && text !== null) node.textContent = String(text);
        return node;
      }

      function safeUrl(url) {
        return typeof url === 'string' && (url.startsWith('https://') || url.startsWith('http://'));
      }

      function appendSection(parent, heading, className) {
        const section = element('section', className || 'learning-section');
        section.append(element('h3', 'learning-heading', heading));
        parent.append(section);
        return section;
      }

      function renderSourceLinks(parent, refs, label) {
        if (!Array.isArray(refs) || !refs.length) return;
        const wrap = element('div', 'learning-sources');
        refs.forEach(ref => {
          const url = typeof ref === 'string' ? ref : ref.url;
          if (!safeUrl(url)) return;
          const link = element('a', '', (typeof ref === 'object' && (ref.title || ref.publisher)) || label);
          link.href = url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          wrap.append(link);
        });
        if (wrap.childNodes.length) parent.append(wrap);
      }

      function renderQuestion(parent, question, words, index) {
        if (!question || typeof question !== 'object') return;
        const details = element('details', 'practice-question');
        const summary = element('summary', 'practice-prompt',
          (index ? index + '. ' : '') + (question.question || question.q || ''));
        details.append(summary);
        const options = question.options;
        if (Array.isArray(options)) {
          const list = element('ol', 'practice-options');
          options.forEach((option, i) => list.append(element('li', '', typeof option === 'object' ? (option.text || option.label || '') : option)));
          details.append(list);
        } else if (options && typeof options === 'object') {
          const list = element('ol', 'practice-options');
          Object.entries(options).forEach(([key, value]) => list.append(element('li', '', key + '. ' + value)));
          details.append(list);
        }
        const answerKey = question.answer || question.correct_answer || question.correct || question.a || '';
        const answer = (question.options && typeof question.options === 'object' &&
          typeof answerKey === 'string' && question.options[answerKey])
          ? answerKey + '. ' + question.options[answerKey] : answerKey;
        if (answer) {
          const line = element('p', 'practice-answer');
          line.append(element('strong', '', words.answer + ': '));
          line.append(document.createTextNode(String(answer)));
          details.append(line);
        }
        const explanation = question.explanation || question.why || '';
        if (explanation) {
          const line = element('p', 'practice-explanation');
          line.append(element('strong', '', words.explanation + ': '));
          line.append(document.createTextNode(String(explanation)));
          details.append(line);
        }
        renderSourceLinks(details, question.source_refs || question.sources, words.sources);
        parent.append(details);
      }

      function renderLearning(parent, learning, story, words) {
        if (!learning || typeof learning !== 'object') {
          learning = {};
        }
        const hasLearning = ['concepts','institutions','processes','distinctions','exam_notes',
          'mcqs','short_questions','analytical_questions','vocabulary','revision']
          .some(key => Array.isArray(learning[key]) && learning[key].length);
        const legacyQa = Array.isArray(story.exam_qa) ? story.exam_qa : [];
        const recall = Array.isArray(story.recall_cards) ? story.recall_cards : [];
        if (!hasLearning && !legacyQa.length && !recall.length) return;

        const panel = element('div', 'exam-learning');
        const conceptItems = [
          ...asArray(learning.concepts), ...asArray(learning.institutions),
          ...asArray(learning.processes), ...asArray(learning.distinctions)
        ];
        if (conceptItems.length) {
          const section = appendSection(panel, words.context);
          conceptItems.forEach(item => {
            if (typeof item === 'string') {
              section.append(element('p', 'learning-copy', item));
              return;
            }
            const entry = element('div', 'learning-entry');
            if (item.title || item.term || item.name) entry.append(element('h4', '', item.title || item.term || item.name));
            if (item.body || item.explanation || item.description) entry.append(element('p', 'learning-copy', item.body || item.explanation || item.description));
            if (Array.isArray(item.points) && item.points.length) {
              const ul = element('ul');
              item.points.forEach(point => ul.append(element('li', '', typeof point === 'object' ? (point.text || point.label || '') : point)));
              entry.append(ul);
            }
            if (item.left && item.right) {
              entry.append(element('p', 'learning-copy', item.left + ' বনাম ' + item.right));
            }
            renderSourceLinks(entry, item.source_refs || item.sources, words.sources);
            section.append(entry);
          });
        }

        if (Array.isArray(learning.exam_notes) && learning.exam_notes.length) {
          const section = appendSection(panel, words.examNotes);
          const ul = element('ul');
          learning.exam_notes.forEach(note => {
            const li = element('li');
            li.append(document.createTextNode(typeof note === 'object' ? (note.text || note.note || '') : note));
            if (note && typeof note === 'object') renderSourceLinks(li, note.source_refs || note.sources, words.sources);
            ul.append(li);
          });
          section.append(ul);
        }

        if (Array.isArray(learning.mcqs) && learning.mcqs.length) {
          const section = appendSection(panel, words.practice);
          learning.mcqs.forEach((q, i) => renderQuestion(section, q, words, i + 1));
        }
        const shortQuestions = [...asArray(learning.short_questions), ...legacyQa];
        if (shortQuestions.length) {
          const section = appendSection(panel, words.shortQuestions);
          shortQuestions.forEach((q, i) => renderQuestion(section, q, words, i + 1));
        }
        if (Array.isArray(learning.analytical_questions) && learning.analytical_questions.length) {
          const section = appendSection(panel, words.written);
          learning.analytical_questions.forEach((q, i) => renderQuestion(section, q, words, i + 1));
        }

        if (Array.isArray(learning.vocabulary) && learning.vocabulary.length) {
          const section = appendSection(panel, words.vocabulary);
          learning.vocabulary.forEach(item => {
            const entry = element('div', 'vocab-entry');
            entry.append(element('h4', '', item.term || item.word || item.phrase || ''));
            const meaning = item.meaning_bn || item.meaning || item.definition || '';
            if (meaning) entry.append(element('p', 'learning-copy', meaning));
            const meta = [item.pronunciation_bn, item.part_of_speech || item.pos].filter(Boolean).join(' · ');
            if (meta) entry.append(element('p', 'vocab-meta', meta));
            if (item.example) entry.append(element('p', 'vocab-example', 'উদাহরণ: ' + item.example));
            if (Array.isArray(item.synonyms) && item.synonyms.length) entry.append(element('p', 'vocab-meta', 'সমার্থক: ' + item.synonyms.join(', ')));
            if (Array.isArray(item.antonyms) && item.antonyms.length) entry.append(element('p', 'vocab-meta', 'বিপরীতার্থক: ' + item.antonyms.join(', ')));
            renderSourceLinks(entry, item.source_refs || item.sources, words.sources);
            section.append(entry);
          });
        }

        const revisionItems = [...asArray(learning.revision), ...recall];
        if (revisionItems.length) {
          const section = appendSection(panel, words.revision);
          const ul = element('ul');
          revisionItems.forEach(item => {
            const text = typeof item === 'string' ? item :
              [item.prompt || item.cloze || item.question, item.answer ? ' → ' + item.answer : ''].filter(Boolean).join('');
            if (text) ul.append(element('li', '', text));
          });
          section.append(ul);
        }
        parent.append(panel);
      }

      function renderEditionExtras(data, words) {
        if (!data || typeof data !== 'object') return;
        const mcqValues = Array.isArray(data.mcqs) ? data.mcqs :
          (data.mcqs && typeof data.mcqs === 'object' ? Object.values(data.mcqs) : []);
        if (mcqValues.length) {
          const panel = element('section', 'edition-extras');
          panel.append(element('h2', 'extras-title', words.practice));
          mcqValues.forEach((q, i) => renderQuestion(panel, q, words, i + 1));
          list.append(panel);
        }

        const vocab = Array.isArray(data.words) ? data.words : [];
        const phrases = Array.isArray(data.phrases) ? data.phrases : [];
        const revisions = Array.isArray(data.revision_words) ? data.revision_words : [];
        if (vocab.length || phrases.length || revisions.length) {
          const panel = element('section', 'edition-extras');
          panel.append(element('h2', 'extras-title', words.vocabulary));
          [...vocab, ...phrases].forEach(item => {
            const term = item['Headword / phrase'] || item['Phrase'] || item.term || '';
            const meaning = item['Bangla meaning'] || item.meaning_bn || item['English definition'] || item['English explanation'] || '';
            const entry = element('article', 'vocab-entry');
            entry.append(element('h4', '', term));
            entry.append(element('p', 'learning-copy', meaning));
            const example = item['Original example'] || item['Original example 1'] || '';
            if (example) entry.append(element('p', 'vocab-example', example));
            panel.append(entry);
          });
          if (revisions.length) {
            panel.append(element('h3', 'learning-heading', words.revision));
            const ul = element('ul');
            revisions.forEach(item => ul.append(element('li', '', item['Headword / phrase'] || item.term || String(item))));
            panel.append(ul);
          }
          list.append(panel);
        }
      }

      function renderStories(stories, words, data) {
        list.replaceChildren();
        stories.forEach((story, index) => {
          const card = element('article', 'story-card');
          const meta = element('div', 'story-meta');
          meta.append(element('span', 'story-number', String(index + 1).padStart(2, '0')));
          meta.append(element('span', 'story-category', story.category || words.story));
          if (story.article_date) meta.append(element('time', 'story-date', story.article_date));
          card.append(meta);
          card.append(element('h2', 'story-title', story.headline || 'Untitled story'));
          if (story.summary) card.append(element('p', 'story-summary', story.summary));
          if (story.why_it_matters) {
            const why = element('div', 'story-why');
            why.append(element('h3', '', words.why));
            why.append(element('p', '', story.why_it_matters));
            card.append(why);
          }
          if (Array.isArray(story.key_facts) && story.key_facts.length) {
            const facts = element('div', 'story-facts');
            facts.append(element('h3', '', words.facts));
            const ul = element('ul');
            story.key_facts.slice(0, 4).forEach(fact => {
              const li = element('li');
              const label = fact.label ? fact.label + ': ' : '';
              li.textContent = label + (fact.value || fact.original || '');
              ul.append(li);
            });
            facts.append(ul);
            card.append(facts);
          }
          renderLearning(card, story.exam_learning || story.learning || {}, story, words);
          const sources = Array.isArray(story.sources) ? story.sources : [];
          if (sources.length) {
            const sourceRow = element('div', 'story-sources');
            sources.forEach(source => {
              if (!safeUrl(source.url)) return;
              const link = element('a', '', source.publication || words.source);
              link.href = source.url;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              sourceRow.append(link);
            });
            card.append(sourceRow);
          }
          list.append(card);
        });
        renderEditionExtras(data, words);
      }

      async function loadEdition() {
        status.lastChild.textContent = labels[language].connecting;
        empty.hidden = true;
        error.hidden = true;
        fallbackNotice.hidden = true;
        list.replaceChildren();
        try {
          const response = await fetch(API_BASE + '/api/v1/briefing?language=' + language, {
            headers: { Accept: 'application/json' }
          });
          if (!response.ok) throw new Error('Briefing API returned ' + response.status);
          const payload = await response.json();
          const words = labels[language];
          if (payload.status === 'translation_pending') {
            status.lastChild.textContent = words.unavailable;
            empty.hidden = false;
            document.querySelector('#empty-title').textContent = words.emptyTitle;
            document.querySelector('#empty-copy').textContent = words.translationPending;
            return;
          }
          if (payload.status !== 'published' || !Array.isArray(payload.stories) || !payload.stories.length) {
            status.lastChild.textContent = words.unavailable;
            empty.hidden = false;
            document.querySelector('#empty-title').textContent = words.emptyTitle;
            document.querySelector('#empty-copy').textContent = words.emptyCopy;
            return;
          }
          status.lastChild.textContent = words.live;
          dateLabel.textContent = payload.edition_date || '';
          fallbackNotice.hidden = true;
          fallbackNotice.textContent = '';
          list.lang = payload.language || language;
          list.dir = 'auto';
          renderStories(payload.stories, words, payload.data || {});
        } catch (err) {
          status.lastChild.textContent = labels[language].unavailable;
          error.hidden = false;
        }
      }

      async function searchArchive(query) {
        const words = labels[language];
        const statusNode = document.querySelector('#archive-status');
        const resultsNode = document.querySelector('#archive-results');
        statusNode.textContent = words.archiveLoading;
        resultsNode.replaceChildren();
        try {
          const url = API_BASE + '/api/v1/archive?q=' + encodeURIComponent(query) + '&limit=30';
          const response = await fetch(url, { headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error('Archive API returned ' + response.status);
          const payload = await response.json();
          const items = Array.isArray(payload.items) ? payload.items : [];
          if (!items.length) {
            statusNode.textContent = words.archiveEmpty;
            return;
          }
          statusNode.textContent = String(payload.total) + (language === 'bn' ? 'টি আর্কাইভ রেকর্ড পাওয়া গেছে' : ' archive records found');
          items.forEach(item => {
            const card = element('article', 'archive-item');
            const meta = element('div', 'archive-meta');
            meta.append(element('span', 'archive-source', item.source || 'Unknown publisher'));
            meta.append(element('span', 'archive-kind', words.archiveNoNotes));
            card.append(meta);
            card.append(element('h3', 'archive-title-text', item.headline || 'Untitled headline'));
            if (item.published) card.append(element('time', 'archive-date', item.published));
            if (item.url && (item.url.startsWith('https://') || item.url.startsWith('http://'))) {
              const link = element('a', 'archive-link', words.archiveOpen);
              link.href = item.url;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              card.append(link);
            }
            resultsNode.append(card);
          });
        } catch (err) {
          statusNode.textContent = words.archiveError;
        }
      }

      document.querySelector('#archive-form').addEventListener('submit', event => {
        event.preventDefault();
        searchArchive(document.querySelector('#archive-query').value || '');
      });

      function setLanguage(next) {
        language = next;
        const words = labels[language];
        document.documentElement.lang = language;
        toggle.textContent = language === 'bn' ? 'English' : 'বাংলা';
        toggle.setAttribute('aria-label', language === 'bn' ? 'Switch to English' : 'Switch to Bangla');
        toggle.setAttribute('aria-pressed', String(language === 'bn'));
        document.querySelector('#page-title').textContent = words.title;
        document.querySelector('#eyebrow').textContent = words.eyebrow;
        document.querySelector('#intro-copy').textContent = words.intro;
        document.querySelector('#archive-title').textContent = words.archiveTitle;
        document.querySelector('#archive-note').textContent = words.archiveNote;
        document.querySelector('#archive-label').textContent = words.archiveLabel;
        document.querySelector('#archive-query').placeholder = words.archivePlaceholder;
        document.querySelector('#archive-submit').textContent = words.archiveButton;
        document.querySelector('footer a:last-child').textContent = words.back;
        loadEdition();
      }

      toggle.addEventListener('click', () => setLanguage(language === 'en' ? 'bn' : 'en'));
      setLanguage(language);
    </script>

