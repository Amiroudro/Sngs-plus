---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14243f" />
    <meta name="description" content="Read the latest human-reviewed Sarangsho Plus bilingual news edition." />
    <title>Today's briefing | Sarangsho Plus</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Sarangsho Plus home">
        <span class="brand-mark">S+</span>
        <span class="brand-name">SARANGSHO <b>PLUS</b></span>
      </a>
      <nav aria-label="Main navigation">
        <a class="active" href="/today">Today</a>
        <a href="/#exam-desk">Exam desk</a>
        <a href="/#method">Our method</a>
      </nav>
      <button class="language" id="language-toggle" type="button" aria-label="Switch to Bangla" aria-pressed="false">বাংলা</button>
    </header>

    <main id="main-content" class="today-shell">
      <section class="today-heading">
        <p class="section-kicker" id="eyebrow">THE SARANGSHO DESK · DAILY EDITION</p>
        <div class="heading-row">
          <div>
            <h1 id="page-title">Today's briefing</h1>
            <p id="edition-date" class="edition-date">Checking for the latest approved edition…</p>
          </div>
          <span class="status-pill" id="edition-status"><span class="status-dot"></span>Connecting</span>
        </div>
        <p id="intro-copy" class="today-intro">Clear reporting, useful context and exam-ready knowledge. Only human-published editions appear here.</p>
      </section>

      <section id="story-list" class="story-list" aria-live="polite" aria-label="Latest news stories"></section>
      <section id="empty-state" class="empty-state" hidden>
        <span class="empty-mark">S+</span>
        <h2 id="empty-title">No approved edition yet</h2>
        <p id="empty-copy">The content pipeline is being connected. This page will show stories only after an edition passes review and is published.</p>
      </section>
      <p id="error-state" class="error-state" hidden>We could not reach the briefing service. Please try again later.</p>
    </main>

    <footer>
      <a class="footer-brand" href="/"><span class="brand-mark">S+</span><span>SARANGSHO <b>PLUS</b></span></a>
      <span class="footer-note">Independent project · Editorial standards first</span>
      <a href="/">Back to home</a>
    </footer>

    <script>
      const API_BASE = import.meta.env.PUBLIC_API_BASE_URL || '';
      const list = document.querySelector('#story-list');
      const empty = document.querySelector('#empty-state');
      const error = document.querySelector('#error-state');
      const status = document.querySelector('#edition-status');
      const dateLabel = document.querySelector('#edition-date');
      const toggle = document.querySelector('#language-toggle');
      const labels = {
        en: {
          title: "Today's briefing", eyebrow: 'THE SARANGSHO DESK · DAILY EDITION',
          intro: 'Clear reporting, useful context and exam-ready knowledge. Only human-published editions appear here.',
          emptyTitle: 'No approved edition yet',
          emptyCopy: 'The content pipeline is being connected. This page will show stories only after an edition passes review and is published.',
          connecting: 'Connecting', live: 'Published edition', unavailable: 'Not published',
          story: 'Story', why: 'Why it matters', facts: 'Key facts', source: 'Read original report',
          back: 'Back to home'
        },
        bn: {
          title: 'আজকের সংবাদসংকলন', eyebrow: 'সারাংশ ডেস্ক · দৈনিক সংস্করণ',
          intro: 'বিশ্বস্ত সংবাদ, প্রয়োজনীয় প্রেক্ষাপট এবং পরীক্ষার উপযোগী জ্ঞান। মানবীয় পর্যালোচনার পর প্রকাশিত সংস্করণই এখানে দেখানো হবে।',
          emptyTitle: 'এখনো অনুমোদিত সংস্করণ প্রকাশিত হয়নি',
          emptyCopy: 'সংবাদ প্রক্রিয়াটি যুক্ত করা হচ্ছে। পর্যালোচনা ও প্রকাশের পরই এখানে সংবাদ দেখানো হবে।',
          connecting: 'সংযোগ করা হচ্ছে', live: 'প্রকাশিত সংস্করণ', unavailable: 'প্রকাশিত হয়নি',
          story: 'সংবাদ', why: 'কেন গুরুত্বপূর্ণ', facts: 'মূল তথ্য', source: 'মূল প্রতিবেদন পড়ুন',
          back: 'প্রচ্ছদে ফিরুন'
        }
      };
      let language = 'en';

      function element(tag, className, text) {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined && text !== null) node.textContent = String(text);
        return node;
      }

      function renderStories(stories, words) {
        list.replaceChildren();
        stories.forEach((story, index) => {
          const card = element('article', 'story-card');
          const meta = element('div', 'story-meta');
          meta.append(element('span', 'story-number', String(index + 1).padStart(2, '0')));
          meta.append(element('span', 'story-category', story.category || words.story));
          if (story.article_date) meta.append(element('time', 'story-date', story.article_date));
          card.append(meta);
          card.append(element('h2', 'story-title', story.headline || 'Untitled story'));
          if (story.summary) card.append(element('p', 'story-summary', story.summary));
          if (story.why_it_matters) {
            const why = element('div', 'story-why');
            why.append(element('h3', '', words.why));
            why.append(element('p', '', story.why_it_matters));
            card.append(why);
          }
          if (Array.isArray(story.key_facts) && story.key_facts.length) {
            const facts = element('div', 'story-facts');
            facts.append(element('h3', '', words.facts));
            const ul = element('ul');
            story.key_facts.slice(0, 4).forEach(fact => {
              const li = element('li');
              const label = fact.label ? fact.label + ': ' : '';
              li.textContent = label + (fact.value || fact.original || '');
              ul.append(li);
            });
            facts.append(ul);
            card.append(facts);
          }
          const sources = Array.isArray(story.sources) ? story.sources : [];
          if (sources.length) {
            const sourceRow = element('div', 'story-sources');
            sources.forEach(source => {
              if (!source.url || !/^https?:\/\//i.test(source.url)) return;
              const link = element('a', '', source.publication || words.source);
              link.href = source.url;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              sourceRow.append(link);
            });
            card.append(sourceRow);
          }
          list.append(card);
        });
      }

      async function loadEdition() {
        status.lastChild.textContent = labels[language].connecting;
        empty.hidden = true;
        error.hidden = true;
        list.replaceChildren();
        try {
          const response = await fetch(API_BASE + '/api/v1/briefing?language=' + language, {
            headers: { Accept: 'application/json' }
          });
          if (!response.ok) throw new Error('Briefing API returned ' + response.status);
          const payload = await response.json();
          const words = labels[language];
          if (payload.status !== 'published' || !Array.isArray(payload.stories) || !payload.stories.length) {
            status.lastChild.textContent = words.unavailable;
            empty.hidden = false;
            document.querySelector('#empty-title').textContent = words.emptyTitle;
            document.querySelector('#empty-copy').textContent = words.emptyCopy;
            return;
          }
          status.lastChild.textContent = words.live;
          dateLabel.textContent = payload.edition_date || '';
          renderStories(payload.stories, words);
        } catch (err) {
          status.lastChild.textContent = labels[language].unavailable;
          error.hidden = false;
        }
      }

      function setLanguage(next) {
        language = next;
        const words = labels[language];
        document.documentElement.lang = language;
        toggle.textContent = language === 'bn' ? 'English' : 'বাংলা';
        toggle.setAttribute('aria-label', language === 'bn' ? 'Switch to English' : 'Switch to Bangla');
        toggle.setAttribute('aria-pressed', String(language === 'bn'));
        document.querySelector('#page-title').textContent = words.title;
        document.querySelector('#eyebrow').textContent = words.eyebrow;
        document.querySelector('#intro-copy').textContent = words.intro;
        document.querySelector('footer a:last-child').textContent = words.back;
        loadEdition();
      }

      toggle.addEventListener('click', () => setLanguage(language === 'en' ? 'bn' : 'en'));
      loadEdition();
    </script>

    <style>
      .today-shell { width: min(100% - 2rem, 920px); margin: 0 auto; padding: 4.5rem 0 6rem; }
      .today-heading { border-bottom: 1px solid var(--line, #dce2e9); padding-bottom: 2rem; margin-bottom: 2rem; }
      .heading-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
      .today-heading h1 { margin: .3rem 0 .5rem; color: var(--ink, #14243f); font: 700 clamp(2.3rem, 7vw, 4.4rem)/1.05 Georgia, serif; letter-spacing: -.04em; }
      .edition-date { color: var(--muted, #667085); margin: 0; }
      .today-intro { max-width: 660px; color: var(--muted, #667085); line-height: 1.7; margin: 1.4rem 0 0; }
      .story-list { display: grid; gap: 1rem; }
      .story-card { background: #fff; border: 1px solid var(--line, #dce2e9); border-radius: 18px; padding: clamp(1.2rem, 4vw, 2rem); box-shadow: 0 8px 28px rgba(20,36,63,.045); }
      .story-meta { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; color: var(--muted, #667085); font-size: .76rem; letter-spacing: .06em; text-transform: uppercase; }
      .story-number { color: #a56c31; font-weight: 800; }
      .story-category { font-weight: 700; }
      .story-date { margin-left: auto; }
      .story-title { font: 700 clamp(1.35rem, 4vw, 2rem)/1.25 Georgia, serif; color: var(--ink, #14243f); margin: 1rem 0; }
      .story-summary { font-size: 1.02rem; line-height: 1.8; color: #344054; white-space: pre-line; }
      .story-why { border-left: 3px solid #b9864b; padding: .25rem 0 .25rem 1rem; margin: 1.2rem 0; }
      .story-why h3, .story-facts h3 { color: var(--ink, #14243f); font-size: .82rem; text-transform: uppercase; letter-spacing: .08em; margin: 0 0 .5rem; }
      .story-why p { color: #475467; line-height: 1.65; margin: 0; }
      .story-facts { background: #f7f8fa; border-radius: 12px; padding: 1rem 1.1rem; margin-top: 1rem; }
      .story-facts ul { margin: 0; padding-left: 1.2rem; color: #344054; line-height: 1.7; }
      .story-sources { display: flex; flex-wrap: wrap; gap: .8rem; border-top: 1px solid var(--line, #dce2e9); margin-top: 1.2rem; padding-top: 1rem; }
      .story-sources a { color: #315b82; font-size: .88rem; font-weight: 700; text-decoration: none; }
      .story-sources a:hover { text-decoration: underline; }
      .empty-state { text-align: center; border: 1px dashed #cbd5e1; border-radius: 20px; padding: 3.5rem 1.5rem; background: rgba(255,255,255,.65); }
      .empty-mark { display: inline-grid; place-items: center; width: 3rem; height: 3rem; border-radius: 12px; background: #14243f; color: white; font-weight: 800; }
      .empty-state h2 { font: 700 1.8rem Georgia, serif; color: var(--ink, #14243f); }
      .empty-state p, .error-state { max-width: 540px; margin: 0 auto; color: var(--muted, #667085); line-height: 1.7; }
      .error-state { text-align: center; padding: 2rem 0; color: #9b3b35; }
      @media (max-width: 640px) { .today-shell { padding-top: 3rem; } .heading-row { display: block; } .status-pill { display: inline-flex; margin-top: 1rem; } .story-date { width: 100%; margin-left: 0; } }
    </style>
  </body>
</html>
